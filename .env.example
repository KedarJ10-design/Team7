# Database Connection (Local SQLite or Remote LibSQL/Turso)
# For local or persistent container (Render/Railway/Docker): "file:./dev.db"
# For Vercel Serverless: "libsql://<your-db-name>.turso.io"
DATABASE_URL="file:./dev.db"

# Optional: Turso Authentication Token (Only required if using remote Turso database on Vercel)
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Session Security Secret
# In production, set to a cryptographically secure random string (minimum 32 characters)
SESSION_PASSWORD="team-goal-tracker-super-secret-session-password-32chars"

# Cron Authentication Secret for Automated Month-Close Endpoint (/api/cron/month-close)
CRON_SECRET="team-goal-tracker-cron-secret-key"
